PROJECT_NAME           = "CAD Viewer"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Industrial-grade 3D CAD Viewer using C++23, Qt 6, and Modern OpenGL"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO

INPUT                  = src main.cpp
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.cpp *.h
RECURSIVE              = YES
EXCLUDE                = build
EXCLUDE_PATTERNS       = */build/* */.git/*

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_MAN           = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src

TAGFILES               =
GENERATE_TAGFILE       =
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES

HAVE_DOT               = NO
HIDE_UNDOC_RELATIONS   = NO

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"

ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          =
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
